rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // OTP codes — Cloud Functions Admin SDK only.
    match /phoneOtpSessions/{phone} {
      allow read, write: if false;
    }

    // Username → login email lookup before sign-in (employee login).
    match /employee_logins/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Signed-in users (admin + employee) — required after Firebase Auth login.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
