# Local development (npm run dev) always uses the Firebase Emulator Suite.
# Do not put production Firebase keys in .env.development or .env.local.
# Production builds read .env.production only.

# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# VITE_FIREBASE_PROJECT_ID=demo-ruthra-local

# Production deploy (default in .env.production)
# VITE_USE_FIREBASE_EMULATORS=false

# Firebase web app config for production builds (Firebase Console → Project settings → Your apps)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Rare: allow demo account bootstrap against a non-emulator dev project (not recommended).
# VITE_ALLOW_DEMO_SEED=false
