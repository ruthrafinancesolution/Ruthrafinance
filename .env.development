# Local development (npm run dev) is emulator-only.
# The app ignores these keys in dev and uses the local emulator project instead.
# Production credentials belong only in .env.production.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

VITE_FIREBASE_API_KEY=local-emulator-only
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-ruthra-local
VITE_FIREBASE_STORAGE_BUCKET=demo-ruthra-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:localemulator
VITE_FIREBASE_MEASUREMENT_ID=

# Admin sign-in emails (comma-separated). Employees sign in with username only.
VITE_ADMIN_EMAIL=ruthra@loanweb.com
